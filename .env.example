# Үлгі: көшіріп, .env деп атаңыз және мәндерді толтырыңыз. Нақты .env файлын git-ке салмаңыз.

# --- Django ---
# Production-да False (әдепкі). True — тек әзірлеуде.
DJANGO_DEBUG=False
# Жаңа кілт: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Сайттың домені/IP, үтір арқылы
DJANGO_ALLOWED_HOSTS=store.example.kz
# HTTPS адресі (админ формалары үшін), үтір арқылы
DJANGO_CSRF_TRUSTED_ORIGINS=https://store.example.kz
DJANGO_TIME_ZONE=Asia/Almaty
# Жүйелік хабарлар тілі: kk (әдепкі) немесе ru
DJANGO_LANGUAGE_CODE=kk
DJANGO_LOG_LEVEL=INFO

# --- HTTPS (reverse proxy: nginx, IIS, Caddy …) ---
# Proxy X-Forwarded-Proto тақырыбын жібереді
DJANGO_BEHIND_HTTPS_PROXY=True
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS: 0 — өшірулі. HTTPS тұрақты жұмыс істегенге көз жеткізген соң 3600, кейін 31536000
DJANGO_SECURE_HSTS_SECONDS=0

# --- PostgreSQL ---
DB_NAME=store_db
DB_USER=store_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Резервтік көшірмелер (manage.py backup_db) ---
# Басқа дискіде болғаны дұрыс: диск істен шықса, көшірме де жоғалмасын
BACKUP_DIR=D:\store_backups
# Осы күннен ескі көшірмелер өшіріледі (0 — өшірмеу); ең жаңасы әрқашан қалады
BACKUP_KEEP_DAYS=14
# pg_dump PATH-та болмаса
BACKUP_PG_BIN=C:\Program Files\PostgreSQL\18\bin

# --- SMTP (production; әзірлеуде хаттар консольға шығады) ---
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True

# --- Waitress (serve.py) ---
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8000
WAITRESS_THREADS=8
# X-Forwarded-* тақырыптарына тек осы адрестен (proxy) сенеді
WAITRESS_TRUSTED_PROXY=127.0.0.1
